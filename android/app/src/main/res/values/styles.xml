<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Native shell theme: keep the Android chrome aligned with the Liquid Glass Studio canvas. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:colorAccent">@color/shell_accent</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/shell_background</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="windowSplashScreenBackground">@color/shell_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
